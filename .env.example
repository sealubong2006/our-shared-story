NODE_ENV=development
PORT=3001
# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/family_album_dev
# Separate database used only by the automated tests (it is wiped on every run)
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/family_album_test
# Random string used to hash visitor IP addresses before storing them
IP_HASH_SALT=change-me-to-a-long-random-string
# Secure cookies. Leave unset in production (defaults to true there); false for local http.
COOKIE_SECURE=false
# Reverse proxies in front of the app. Leave unset: 0 locally, 1 in production (Railway).
# TRUST_PROXY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
