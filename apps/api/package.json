{
  "name": "@family-album/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:setup-local": "tsx --env-file=../../.env scripts/setup-local-db.ts",
    "codes": "tsx --env-file=../../.env scripts/codes.ts",
    "r2:check": "tsx --env-file=../../.env scripts/r2-check.ts",
    "release": "node dist/db/migrate.js && node dist/db/seed.js",
    "codes:prod": "node dist/codes.js",
    "r2:check:prod": "node dist/r2-check.js",
    "backup": "tsx --env-file=../../.env scripts/backup.ts",
    "backup:prod": "node dist/backup.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@family-album/shared": "*",
    "archiver": "^8.0.0",
    "blurhash": "^2.0.5",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
